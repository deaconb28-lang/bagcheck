{
  "name": "bagcheck",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "tsx --test \"lib/**/*.test.ts\"",
    "cron": "node scripts/cron.mjs",
    "avatars": "node --import tsx scripts/generate-avatars.mjs",
    "avatars:manifest": "node --import tsx scripts/avatar-manifest.mjs",
    "avatars:sheet": "node --import tsx scripts/avatar-sheet.mjs",
    "backdrops": "node --import tsx scripts/generate-backdrops.mjs",
    "photos": "node --import tsx scripts/fetch-photos.mjs",
    "fonts": "node scripts/vendor-fonts.mjs",
    "seed": "node --import tsx scripts/seed.mjs",
    "shots": "node --import tsx scripts/shots.mjs",
    "sheet": "node --import tsx scripts/contact-sheet.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@auth/mongodb-adapter": "^3.11.3",
    "jszip": "^3.10.1",
    "mongodb": "^6.21.0",
    "next": "^15.4.6",
    "next-auth": "^5.0.0-beta.32",
    "openai": "^7.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "snaptrade-typescript-sdk": "^11.0.4",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.23",
    "mongodb-memory-server": "^11.2.0",
    "playwright-core": "^1.62.1",
    "sharp": "^0.34.5",
    "tsx": "^4.23.9",
    "typescript": "^5"
  }
}
