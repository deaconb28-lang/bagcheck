# Copy to .env.local and fill in. Every integration degrades gracefully when
# its variables are missing — /debug shows which are set.

# Auth — Google via Auth.js. Required for sign-in.
# No final domain needed: register the OAuth client with
# http://localhost:3000 and your vercel.app URL as authorized origins
# (redirect URI: <origin>/api/auth/callback/google) and add the real
# domain to the same client later.
AUTH_SECRET=            # openssl rand -base64 32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Stand-in identity while auth is unconfigured. Only active when ALL three
# AUTH_* vars are missing. Lets /debug and the SnapTrade routes run without
# sign-in. On a public deployment this exposes that ledger to anyone with
# the URL — prefer setting it locally only, and remove it after testing.
DEV_USER_ID=

# MongoDB Atlas — the ledger store. Required for SnapTrade sync.
MONGODB_URI=
MONGODB_DB=bagcheck

# SnapTrade — read-only brokerage data. Required for connect + sync.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# Anthropic — writes the daily readout on Today. Optional: without it the
# app uses its deterministic readout instead, and nothing else changes.
ANTHROPIC_API_KEY=

# Later milestones

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
BLOB_READ_WRITE_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
SENTRY_DSN=
MARKET_DATA_API_KEY=
CRON_SECRET=

# Stripe — subscriptions. Optional: without these the plan card says billing
# is unconfigured and every tier reads as free. Sharing and rarity are never
# gated, at any tier, so an unconfigured deployment loses no card features.
STRIPE_SECRET_KEY=          # sk_live_… or sk_test_…
STRIPE_PRICE_PLUS=          # price_… for Plus, $9/mo
STRIPE_PRICE_TRADER=        # price_… for Trader, $29/mo

# Signing secret for the webhook endpoint, NOT an API key. Stripe issues one
# per endpoint: Dashboard → Developers → Webhooks → add
# <your-domain>/api/billing/webhook, then copy its "Signing secret" (whsec_…).
# It exists only after the endpoint is created, and it differs between test
# mode, live mode, and `stripe listen` locally.
STRIPE_WEBHOOK_SECRET=      # whsec_…

# Absolute origin for Checkout's return legs. On Vercel this is inferred from
# VERCEL_PROJECT_PRODUCTION_URL; set it explicitly once you have a domain.
NEXT_PUBLIC_SITE_URL=

# logo.dev — company marks beside tickers, on ledger rows, holdings and share
# cards. Optional: without it every mark falls back to a drawn monogram in the
# product's palette, and nothing breaks. The token is proxied through
# /api/logo so it never appears in the page.
LOGO_DEV_TOKEN=             # also accepts LOGODEV_TOKEN / LOGO_DEV_API_KEY

# OpenAI — generates the backdrop artwork for Wrapped cards, and nothing else.
# Anthropic still writes every sentence in the product. Optional: without it a
# Wrapped card renders on the flat ink field, which is a complete card.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=         # defaults to gpt-image-2
