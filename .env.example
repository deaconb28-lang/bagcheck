# Copy to .env.local and fill in. Every integration degrades gracefully when
# its variables are missing.

# ── The two gates ──────────────────────────────────────────────────────────
# APP_UNLOCKED opens the product. Unset, every /home, /you and /profile route
# redirects to the landing and the site is the waitlist only — which means a
# reader can connect a brokerage, watch it sync, press "Open your dashboard"
# and land back on the marketing page. Set it to 1 to launch.
APP_UNLOCKED=

# DEBUG_PAGE opens /debug, and it is deliberately NOT the same flag: that page
# names every secret, prints the raw ledger and carries live Sync and Score
# buttons. Leave it unset in production. Unset, the route 404s.
DEBUG_PAGE=

# The public origin. Everything that builds an absolute URL reads this —
# SnapTrade's return, Stripe's checkout return, unsubscribe links. Without it
# they resolve against the request, which behind a proxy is localhost.
APP_URL=

# Auth — Google via Auth.js. Required for sign-in.
# No final domain needed: register the OAuth client with
# http://localhost:3000 and your vercel.app URL as authorized origins
# (redirect URI: <origin>/api/auth/callback/google) and add the real
# domain to the same client later.
AUTH_SECRET=            # openssl rand -base64 32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Stand-in identity while auth is unconfigured. Only active when ALL three
# AUTH_* vars are missing. Lets /debug and the SnapTrade routes run without
# sign-in. On a public deployment this exposes that ledger to anyone with
# the URL — prefer setting it locally only, and remove it after testing.
DEV_USER_ID=

# MongoDB Atlas — the ledger store. Required for SnapTrade sync.
MONGODB_URI=
MONGODB_DB=bagcheck

# SnapTrade — read-only brokerage data. Required for connect + sync.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# Anthropic — writes the daily readout on Today. Optional: without it the
# app uses its deterministic readout instead, and nothing else changes.
ANTHROPIC_API_KEY=

# Later milestones

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BLOB_READ_WRITE_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
SENTRY_DSN=
CRON_SECRET=

# Stripe — subscriptions. Optional: without these the plan card says billing
# is unconfigured and every tier reads as free. Sharing and rarity are never
# gated, at any tier, so an unconfigured deployment loses no card features.
STRIPE_SECRET_KEY=          # sk_live_… or sk_test_…
STRIPE_PRICE_PLUS=          # price_… for Plus, $9/mo
STRIPE_PRICE_TRADER=        # price_… for Trader, $29/mo

# Signing secret for the webhook endpoint, NOT an API key. Stripe issues one
# per endpoint: Dashboard → Developers → Webhooks → add
# <your-domain>/api/billing/webhook, then copy its "Signing secret" (whsec_…).
# It exists only after the endpoint is created, and it differs between test
# mode, live mode, and `stripe listen` locally.
STRIPE_WEBHOOK_SECRET=      # whsec_…

# Absolute origin for Checkout's return legs. On Vercel this is inferred from
# VERCEL_PROJECT_PRODUCTION_URL; set it explicitly once you have a domain.
NEXT_PUBLIC_SITE_URL=

# logo.dev — company marks beside tickers, on ledger rows, holdings and share
# cards. Optional: without it every mark falls back to a drawn monogram in the
# product's palette, and nothing breaks. The token is proxied through
# /api/logo so it never appears in the page.
LOGO_DEV_TOKEN=             # also accepts LOGODEV_TOKEN / LOGO_DEV_API_KEY

# OpenAI — draws, and only draws. Two uses and no third:
#   1. the backdrop artwork for Wrapped cards, generated at mint;
#   2. the sixteen archetype avatars, generated once by `npm run avatars`
#      into public/archetypes and committed.
# Anthropic still writes every sentence in the product. Optional in both
# cases: a Wrapped card without art renders on the flat ink field, and an
# archetype without art renders the drawn emblem — both are finished states.
# The avatars need this key only on the machine that generates them, never on
# a deployment: they are static files by the time they ship.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=         # defaults to gpt-image-2

# Finnhub — market data, used to backcheck the brokerage: refreshing a mark
# the last sync left stale, naming a ticker the brokerage sent bare, and the
# reporting dates for names already held. Optional: without it the screens
# show the brokerage's own numbers and say so. Quotes never become an alert.
FINNHUB_API_KEY=            # also accepts FINNHUB_TOKEN / MARKET_DATA_API_KEY

# The Noun Project — glyphs for the ledger kinds. Both halves are required:
# the API signs with two-legged OAuth 1.0a, so a key without its secret
# cannot sign anything. Get a pair at thenounproject.com/developers.
# Optional: without them <Icon> renders nothing and the screens look exactly
# as they did before, which is how they were designed.
# Icons are fetched once and stored in Mongo, never fetched on read. They are
# CC-BY, so /legal/icons names whoever drew each one.
NOUN_PROJECT_KEY=           # also accepts NOUN_PROJECT_API_KEY
NOUN_PROJECT_SECRET=        # also accepts NOUN_PROJECT_API_SECRET

# Resend — the daily brief and the weekly recap. Both are opt-in and off by
# default, and the send log allows exactly one message per user per day. There
# is no price alert and no place in lib/email to write one. Optional: without
# these the cron returns 503 and nothing is sent.
RESEND_API_KEY=             # re_…
EMAIL_FROM=                 # e.g. "Bagcheck <brief@mail.bagcheck.app>"

# Absolute origin used in email links and unsubscribe URLs. Falls back to the
# request origin when unset, which is wrong behind a proxy — set it.
APP_URL=

# Unsplash — one photograph behind each Wrapped card's artwork, as material
# for the drawn geometry rather than a subject in its own right. Optional:
# without a key the cards wear the drawn shapes alone, which is a finished
# design rather than a placeholder.
# Photographs are fetched once into Mongo and only ever read on render, so
# traffic cannot spend quota. Their terms are why we store the URL and never
# the bytes — the image is hotlinked from their CDN — and why /legal/photos
# names every photographer.
UNSPLASH_ACCESS_KEY=        # the public "Access Key" from unsplash.com/oauth/applications

# Fills that store: POST /api/photos/refresh with this as a bearer token, or
# run `npm run photos` with the two variables above in your shell. Unset means
# the route does not exist. Re-running re-picks every photograph, so cards
# people have already posted change — do it deliberately.
PHOTOS_REFRESH_TOKEN=
