# Copy to .env.local and fill in. Every integration degrades gracefully when
# its variables are missing.

# ── The two gates ──────────────────────────────────────────────────────────
# APP_LOCKED shuts the product, and it is off unless you set it. Leave it unset
# and /you, /wrapped and /profile all answer normally.
#
# It used to be the reverse — APP_UNLOCKED=1 to open — and that failed the way
# a default-closed gate always does: every fresh deployment shipped shut, and a
# shut door here is not an error page but a silent 307 back to the marketing
# site. A second host sat like that for days, so a reader could connect a
# brokerage, watch it sync, press "Open your dashboard" and land on the landing
# with nothing said. Closing is now the deliberate act.
#
# Set APP_LOCKED=1 to take the product down to the waitlist. APP_UNLOCKED=0
# still shuts it too, for any deployment that carries the older variable.
APP_LOCKED=

# DEBUG_PAGE opens /debug, and it is deliberately NOT the same flag: that page
# names every secret, prints the raw ledger and carries live Sync and Score
# buttons. Leave it unset in production. Unset, the route 404s.
DEBUG_PAGE=

# The public origin. Everything that builds an absolute URL reads this —
# SnapTrade's return, Stripe's checkout return, unsubscribe links. Without it
# they resolve against the request, which behind a proxy is localhost.
APP_URL=

# Auth — Google via Auth.js. Required for sign-in.
# No final domain needed: register the OAuth client with
# http://localhost:3000 and your vercel.app URL as authorized origins
# (redirect URI: <origin>/api/auth/callback/google) and add the real
# domain to the same client later.
AUTH_SECRET=            # openssl rand -base64 32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Stand-in identity while auth is unconfigured. Only active when ALL three
# AUTH_* vars are missing. Lets /debug and the SnapTrade routes run without
# sign-in. On a public deployment this exposes that ledger to anyone with
# the URL — prefer setting it locally only, and remove it after testing.
DEV_USER_ID=

# MongoDB Atlas — the ledger store. Required for SnapTrade sync.
#
# MONGODB_DB names the database, and on a deployment that already holds a
# ledger it must keep naming the one the ledger is in. The product has been
# renamed three times and storage never followed, so an existing deployment's
# database may still be called something the product no longer is. This value
# is the default for a *fresh* setup; it is not a value to paste over a live
# one. Unsetting it on a deployment with real data reads every account as new.
MONGODB_URI=
MONGODB_DB=supercruise

# SnapTrade — read-only brokerage data. Required for connect + sync.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# Anthropic — writes the daily readout on the dashboard. Optional: without it
# the app uses its deterministic readout instead, and nothing else changes.
ANTHROPIC_API_KEY=

# Declared but read by no file yet — observability and rate limiting are
# deliberately deferred past v1. Setting them changes nothing today; they are
# listed so the names are already the right ones when the code arrives.
#
#   BLOB_READ_WRITE_TOKEN
#   UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
#   NEXT_PUBLIC_POSTHOG_KEY
#   SENTRY_DSN

# Stripe — subscriptions. Optional: without these the plan card says billing
# is unconfigured and every tier reads as free. Sharing and rarity are never
# gated, at any tier, so an unconfigured deployment loses no card features.
STRIPE_SECRET_KEY=          # sk_live_… or sk_test_…

# One paid plan, one price. The two older names are still read as fallbacks
# because live subscriptions are attached to those price objects, and a rename
# in the repo must not drop an existing subscriber to free.
STRIPE_PRICE_PRO=           # price_… for Pro, $9/mo
STRIPE_PRICE_PLUS=          # legacy, read only if STRIPE_PRICE_PRO is unset
STRIPE_PRICE_TRADER=        # legacy, same

# Signing secret for the webhook endpoint, NOT an API key. Stripe issues one
# per endpoint: Dashboard → Developers → Webhooks → add
# <your-domain>/api/billing/webhook, then copy its "Signing secret" (whsec_…).
# It exists only after the endpoint is created, and it differs between test
# mode, live mode, and `stripe listen` locally.
STRIPE_WEBHOOK_SECRET=      # whsec_…

# Absolute origin for Checkout's return legs. APP_URL below is read first and
# is the one to set; this stays as a fallback for a Vercel-style deployment.
NEXT_PUBLIC_SITE_URL=

# logo.dev — the first link in the company-mark chain, and the only one that
# needs a key. Genuinely optional: Financial Modeling Prep and parqet serve
# ticker marks without one, so an empty value here costs a source rather than
# the feature, and a ticker no source has falls back to a drawn monogram.
# (It was not optional enough before — with this unset, every holding, every
# ledger row and every share card rendered a monogram, which is what an
# unconfigured app looks like.) The token is proxied through /api/logo so it
# never appears in the page.
LOGO_DEV_TOKEN=             # also accepts LOGODEV_TOKEN / LOGO_DEV_API_KEY

# OpenAI — draws, and only draws. Three uses and no fourth:
#   1. the backdrop artwork for Wrapped cards, generated at mint;
#   2. the sixteen archetype avatars, generated once by `npm run avatars`
#      into public/archetypes and committed;
#   3. the three ambient fields, generated once by `npm run ambient` into
#      public/ambient and committed — the light behind the dashboard's score
#      ring and behind both waiting states.
# Anthropic still writes every sentence in the product. Optional in all three
# cases: a Wrapped card without art renders on the flat ink field, an
# archetype without art renders the drawn emblem, and an ambient field that is
# absent leaves the CSS gradient it is layered over — every one of those is a
# finished state. The ambient fields matter most here, because two of the
# three sit on *loading* screens: a picture a reader has to wait for, on the
# screen that exists to fill a wait, must never be the design.
# Cases 2 and 3 need this key only on the machine that generates them, never
# on a deployment: they are static files by the time they ship.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=         # defaults to gpt-image-2

# Finnhub — market data, used to backcheck the brokerage: refreshing a mark
# the last sync left stale, naming a ticker the brokerage sent bare, and the
# reporting dates for names already held. Optional: without it the screens
# show the brokerage's own numbers and say so. Quotes never become an alert.
FINNHUB_API_KEY=            # also accepts FINNHUB_TOKEN / MARKET_DATA_API_KEY

# The Noun Project — glyphs for the ledger kinds. Both halves are required:
# the API signs with two-legged OAuth 1.0a, so a key without its secret
# cannot sign anything. Get a pair at thenounproject.com/developers.
# Optional: without them <Icon> renders nothing and the screens look exactly
# as they did before, which is how they were designed.
# Icons are fetched once and stored in Mongo, never fetched on read. They are
# CC-BY, so /legal/icons names whoever drew each one.
NOUN_PROJECT_KEY=           # also accepts NOUN_PROJECT_API_KEY
NOUN_PROJECT_SECRET=        # also accepts NOUN_PROJECT_API_SECRET

# Resend — the daily brief and the weekly recap. Both are opt-in and off by
# default, and the send log allows exactly one message per user per day. There
# is no price alert and no place in lib/email to write one. Optional: without
# these the cron returns 503 and nothing is sent.
RESEND_API_KEY=             # re_…
EMAIL_FROM=                 # e.g. "Canopy <brief@mail.canopy.app>"

# Email links and unsubscribe URLs read APP_URL, declared at the top of this
# file. It was declared a second time here, which in a `.env` is not a comment
# about the same variable but a redefinition of it — whichever line came last
# won, and a blank one below a filled one silently emptied it.

# Unsplash — one photograph behind each Wrapped card's artwork, as material
# for the drawn geometry rather than a subject in its own right. Optional:
# without a key the cards wear the drawn shapes alone, which is a finished
# design rather than a placeholder.
# Photographs are fetched once into Mongo and only ever read on render, so
# traffic cannot spend quota. Their terms are why we store the URL and never
# the bytes — the image is hotlinked from their CDN — and why /legal/photos
# names every photographer.
UNSPLASH_ACCESS_KEY=        # the public "Access Key" from unsplash.com/oauth/applications

# Fills that store: POST /api/photos/refresh with this as a bearer token, or
# run `npm run photos` with the two variables above in your shell. Unset means
# the route does not exist. Re-running re-picks every photograph, so cards
# people have already posted change — do it deliberately.
PHOTOS_REFRESH_TOKEN=

# ── The nightly jobs ───────────────────────────────────────────────────────
# CRON_SECRET guards /api/cron/*; without it both routes answer 401 to
# everyone, including you. Generate one and set the same value on the app
# service and on the cron service.
#
# The cron itself is a separate Railway service running `npm run cron`, which
# calls both endpoints with this secret. Each call sweeps the next slice of
# connected users and remembers where it stopped, so the schedule decides how
# fast a full pass goes round rather than one request having to cover
# everyone. Every 15 minutes is a reasonable start.
#
# The cron service needs exactly three variables: APP_URL, CRON_SECRET and
# optionally CRON_JOBS. It never touches the database.
CRON_SECRET=                # openssl rand -hex 32
CRON_JOBS=                  # optional; defaults to "nightly-score,notify"

# The address printed on /legal/privacy and /legal/terms. Defaults to the
# owner's personal address, which works but is worth replacing with one on
# your own domain before launch.
SUPPORT_EMAIL=
